# Editor / OS clutter
.idea/
.vscode/
.DS_Store

# R session files
.Rhistory
.RData
.Rproj.user/

# Raw and reference data (huge; re-downloadable)
*.sra
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fa
*.fa.gz
*.fasta
*.gtf
*.gtf.gz

# kallisto index (large binary)
*.idx

# Keep the data folder, but ignore everything in it except its README
data/*
!data/README.md

# SLURM log files
slurm-*.out
slurm-*.err

# kallisto quant outputs: keep run_info.json, ignore the large abundance files
abundance.h5
abundance.tsv

# Ildiko's SLURM logs: ignore all, except the index build log
logs/ildiko/*.out
!logs/ildiko/kallisto_index_*.out
